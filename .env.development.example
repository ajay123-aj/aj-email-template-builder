# Used when running `npm run dev` (Vite development mode)
# Copy to .env.development: npm run env:dev

DEV_SERVER_PORT=4002

# API base: {origin}{prefix}/api/aj-email-editor/leads/collect
VITE_LEAD_COLLECT_API_ORIGIN=https://aj-api.ajtechhub.com
VITE_API_PREFIX=/api-backend

# Optional: local site URL for SEO preview
# VITE_SITE_URL=http://localhost:4002

# Ask AI (optional in dev)
# VITE_ASK_AI_ENABLED=on
# VITE_OPENAI_API_KEY=your-api-key
# VITE_OPENAI_BASE_URL=https://api.openai.com/v1
# VITE_OPENAI_MODEL=gpt-4o
